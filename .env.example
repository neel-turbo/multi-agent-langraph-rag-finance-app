# ── Providers ──────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
OLLAMA_BASE_URL=http://localhost:11434
TAVILY_API_KEY=tvly-...
# Market data: yahoo (no key, India + world) | twelve-data | alpha-vantage
MARKET_PROVIDER=yahoo
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_BUDGET=25

# Portfolio: Zerodha Kite. Blank = Kite's public demo account (DEMOUSER, fixed snapshot prices).
# Set both (from the Kite Connect login flow) to read your real holdings instead.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── LLM: which provider runs the agents ────────────────────
# google-genai (Gemini) | anthropic (Claude) | openai | ollama (local)
LLM_PROVIDER=google-genai
# Used when the primary errors (quota, rate limit, outage). "none" to disable.
LLM_FALLBACK_PROVIDER=ollama

# Keys: only the providers you actually use need one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model per provider (used by every role on that provider)
GOOGLE_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5
OLLAMA_MODEL=qwen3.5:4b

# Optional per-role overrides: PLANNER_ / AGENT_ (+ REVIEWER_ / SYNTHESIZER_, currently unused)
# PLANNER_PROVIDER=anthropic
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5-mini
# AGENT_FALLBACK_PROVIDER=none

# ── RAG ────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
EMBED_MODEL=Xenova/bge-small-en-v1.5

# ── Browser (VITE_ prefix is public) ───────────────────────
VITE_LANGGRAPH_URL=http://localhost:2024
VITE_MARKET_API=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
MARKET_API_PORT=8787
