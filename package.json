{
  "name": "finance-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,graph,api -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:graph\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:graph": "langgraphjs dev --port 2024",
    "ingest": "tsx src/server/rag/ingest.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "dev:api": "tsx watch --env-file=.env --include .env src/server/api/server.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.12",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/langgraph-sdk": "^1.9.28",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/tavily": "^1.2.0",
    "@llamaindex/liteparse": "^2.0.0",
    "chromadb": "^3.0.0",
    "langchain": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yahoo-finance2": "^3.15.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
